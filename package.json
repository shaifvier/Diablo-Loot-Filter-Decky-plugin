{
  "name": "diablo-loot-filters",
  "version": "0.1.1",
  "description": "Browse and generate native Diablo IV loot filters in Decky game mode.",
  "type": "module",
  "license": "MIT",
  "author": "shaifvier",
  "repository": {"type": "git", "url": "https://github.com/shaifvier/Diablo-Loot-Filter-Decky-plugin.git"},
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v",
    "package": "python3 scripts/package.py"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "4.53.3",
    "typescript": "5.6.3"
  },
  "dependencies": {"@decky/api": "1.1.3", "react-icons": "5.3.0", "tslib": "2.7.0"},
  "pnpm": {"peerDependencyRules": {"ignoreMissing": ["react", "react-dom"]}},
  "packageManager": "pnpm@9.15.9"
}
