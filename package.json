{
  "name": "diablo-loot-filters",
  "version": "0.2.0-beta.1",
  "description": "Browse and generate native Diablo IV loot filters in Decky game mode.",
  "type": "module",
  "license": "MIT",
  "author": "shaifvier",
  "repository": {
    "type": "git",
    "url": "https://github.com/shaifvier/Diablo-Loot-Filter-Decky-plugin.git"
  },
  "scripts": {
    "build": "rollup -c",
    "build:preview": "DECKY_PREVIEW=1 rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v && node tests/viewer-store.cjs",
    "package": "python3 scripts/package.py",
    "package:preview": "python3 scripts/package.py --preview"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "4.53.3",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "react-icons": "5.3.0",
    "tslib": "2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "packageManager": "pnpm@9.15.9"
}
